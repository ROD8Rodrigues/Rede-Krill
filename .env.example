# Copie este arquivo para .env e preencha os valores.
# Nunca versiona o .env. Os valores abaixo são exemplos e devem ser trocados.

# --- Banco de dados ---
POSTGRES_DB=rede_krill
POSTGRES_USER=redekrill
# Obrigatório. Use uma senha longa e aleatória.
POSTGRES_PASSWORD=

# --- Aplicação ---
# dev: cookies sem Secure e token exposto (somente máquina local)
# prod: cookies Secure, Swagger desabilitado e validações de produção
SPRING_PROFILES_ACTIVE=dev
FRONTEND_PORT=8081
BACKEND_PORT=8080
# Inclua a porta real do Vite: em outra porta o backend responde 403 "Invalid CORS request".
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- JWT ---
# Obrigatório. Gere com: openssl rand -base64 48
JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_EXPOSE_TOKEN_IN_RESPONSE=true
TRUST_FORWARDED_HEADERS=false

# --- Administrador inicial ---
# Deixe SEED_ADMIN_ENABLED=false em produção após criar o primeiro ADMIN.
# Em dev, defina uma senha temporária forte; ela deve ser trocada no primeiro acesso.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@redekrill.com
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_REQUIRE_PASSWORD_CHANGE=true

# --- E-mail ---
# Para desenvolvimento com MailHog (perfil dev):
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=nao-responda@redekrill.com
EMAIL_OUTBOX_ENABLED=true

# --- Observabilidade e documentação ---
SPRINGDOC_ENABLED=false
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
