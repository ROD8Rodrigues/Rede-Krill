# Este arquivo é OPCIONAL.
#
# `docker-compose up` sobe a stack inteira sem ele: o docker-compose.yml traz padrões de
# desenvolvimento para senha do banco, seed do ADMIN, porta e SMTP, e o perfil `dev` gera o
# segredo de assinatura do JWT em memória quando não recebe JWT_SECRET. Copie para `.env`
# quando precisar mudar um padrão, trocar portas ou preparar uma subida de produção.
#
# Nunca versiona o .env. Os valores abaixo são exemplos e devem ser trocados.
#
# Duas variáveis mudam de valor conforme o caminho, porque o "host" muda de lado:
# MAIL_HOST=mailhog vale dentro da rede do compose; rodando sem Docker (.\start-dev.ps1) é
# localhost:1025, já que o MailHog published a porta no host. TRUST_FORWARDED_HEADERS=true
# só faz sentido atrás do proxy do nginx; expor o backend direto deixa false, senão o próprio
# cliente inventa o endereço e o lockout por IP conta tentativas contra uma fantasia.

# --- Banco de dados ---
POSTGRES_DB=rede_krill
POSTGRES_USER=redekrill
# Sem valor, o compose usa a senha de desenvolvimento (recusada no perfil prod).
POSTGRES_PASSWORD=

# --- Aplicação ---
# dev: cookies sem Secure, Swagger ligado, seed e segredo de JWT efêmero permitidos
# prod: cookies Secure, Swagger só para ADMIN e validações de produção que recusam o boot
SPRING_PROFILES_ACTIVE=dev
FRONTEND_PORT=8081
BACKEND_PORT=8080
# Inclua a porta real do Vite: em outra porta o backend responde 403 "Invalid CORS request".
# Pelo compose o frontend sai da mesma origem que a API (proxy /api), então isto é opcional.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

# --- JWT ---
# Obrigatório em produção. Gere com: openssl rand -base64 48
JWT_SECRET=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_EXPOSE_TOKEN_IN_RESPONSE=false
# Também comentado: true é o valor correto atrás do proxy do nginx (compose), false quando o
# backend responde direto ao cliente — sem proxy, quem inventa o X-Forwarded-For é o próprio
# cliente e o lockout por IP passaria a contar endereços falsos.
# TRUST_FORWARDED_HEADERS=true

# --- Administrador inicial ---
# Em dev o compose habilita o seed com uma senha de desenvolvimento; preencha
# SEED_ADMIN_PASSWORD para usar a sua (mínimo 12 caracteres, letras e números).
# Deixe SEED_ADMIN_ENABLED=false em produção após criar o primeiro ADMIN.
# Não publica uma senha real aqui: este arquivo vai ao repositório.
SEED_ADMIN_ENABLED=true
SEED_ADMIN_NAME=Administrador
SEED_ADMIN_EMAIL=admin@redekrill.com
SEED_ADMIN_PASSWORD=
SEED_ADMIN_REQUIRE_PASSWORD_CHANGE=false

# --- Sessões de refresh ---
# Linhas vencidas há mais de SESSION_EXPIRED_RETENTION são removidas pelo job periódico.
SESSION_EXPIRED_RETENTION=7d
SESSION_CLEANUP_ENABLED=true
SESSION_CLEANUP_INTERVAL=12h

# --- Hash de senha ---
# Custo do BCrypt. 12 é o default do backend; o valor atual fica embutido em cada hash,
# então elevar o fator não invalida senhas já armazenadas — só as próximas trocas.
BCRYPT_STRENGTH=12

# --- E-mail ---
# MAIL_HOST fica comentado de propósito: cada caminho tem o seu padrão. Dentro do compose o
# backend alcança o serviço `mailhog`; rodando com .\start-dev.ps1 ele usa localhost:1025,
# porque o MailHog publicado no host está lá. Descomente apenas para apontar para um SMTP real.
# MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=nao-responda@redekrill.com
EMAIL_OUTBOX_ENABLED=true

# --- Observabilidade e documentação ---
SPRINGDOC_ENABLED=true
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
